        "        'CNN_R2': cnn_r2[i],\n",
        "        'CNN_RMSE': cnn_rmse[i]\n",
        "    })\n",
        "\n",
        "comparison_df = pd.DataFrame(comparison_data)\n",
        "print('\\nModel Comparison Summary:')\n",

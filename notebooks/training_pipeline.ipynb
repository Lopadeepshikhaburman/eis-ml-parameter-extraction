      "source": [
        "# EIS ML Parameter Extraction - Complete Training Pipeline\n",
        "## Machine Learning Assisted Extraction of Electrochemical Parameters from EIS Data\n",
        "\n",
        "**Author:** Deepshikha Burman\n",
        "\n",
        "This notebook implements the complete ML pipeline developed through Trials 1-5, including:\n",
        "- Synthetic EIS data generation from equivalent circuits\n",
        "- Feature engineering and preprocessing\n",
        "- Multiple ML models (Random Forest, MLP, 1D-CNN)\n",
        "- Comprehensive evaluation and visualization\n",
        "- Model comparison and selection\n",
        "\n",
        "### Target Parameters:\n",
        "- Rs (Solution Resistance)\n",
        "- Rct (Charge Transfer Resistance)\n",
        "- Cdl (Double Layer Capacitance)\n",
        "- Warburg Coefficient\n",
        "- Specific Capacitance\n",
        "- Energy Density\n",
        "- Power Density\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "setup"
      },
      "source": [
        "# ============================================================\n",
        "# CELL 1 — SETUP: Install & Import\n",
        "# ============================================================\n",
        "!pip install impedance torch torchvision scikit-learn pandas numpy matplotlib seaborn -q\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n",
        "from sklearn.ensemble import RandomForestRegressor\n",
        "from sklearn.neural_network import MLPRegressor\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "\n",
        "# Reproducibility\n",
        "SEED = 42\n",
        "np.random.seed(SEED)\n",
        "torch.manual_seed(SEED)\n",
        "\n",
        "DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print(f'Device: {DEVICE}')\n",
        "print('Setup complete.')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "data_generation"
      },
      "source": [
        "# ============================================================\n",
        "# CELL 2 — SYNTHETIC DATA GENERATION\n",
        "# ============================================================\n",
        "\n",
        "def generate_frequency_grid(n_points=100, f_min=1e-3, f_max=1e6):\n",
        "    \"\"\"Generate logarithmically spaced frequency grid\"\"\"\n",
        "    return np.logspace(np.log10(f_min), np.log10(f_max), n_points)\n",
        "\n",
        "def generate_randles_circuit(n_samples, frequencies):\n",
        "    \"\"\"\n",
        "    Generate synthetic EIS data using Randles circuit: Rs-(Rct||Cdl)-W\n",
        "    \"\"\"\n",
        "    Rs = np.random.uniform(0.01, 10, n_samples)\n",
        "    Rct = np.random.uniform(0.1, 100, n_samples)\n",
        "    Cdl = np.random.uniform(1e-6, 1e-2, n_samples)\n",
        "    W = np.random.uniform(0.01, 5, n_samples)\n",
        "    \n",
        "    spectra = []\n",
        "    labels = []\n",
        "    \n",
        "    for i in range(n_samples):\n",
        "        f = frequencies\n",
        "        omega = 2 * np.pi * f\n",
        "        \n",
        "        # Randles circuit impedance\n",
        "        Z_real = Rs[i] + Rct[i]/(1 + (omega*Cdl[i])**2)\n",
        "        Z_imag = (omega*Cdl[i]*Rct[i])/(1 + (omega*Cdl[i])**2) + W[i]/np.sqrt(omega + 1e-10)\n",
        "        \n",
        "        spectrum = np.concatenate((Z_real, Z_imag))\n",
        "        spectra.append(spectrum)\n",
        "        \n",
        "        # Calculate derived properties\n",
        "        capacitance = Cdl[i]\n",
        "        energy_density = 0.5 * capacitance * (2.7**2)\n",
        "        power_density = (2.7**2)/(4*Rct[i])\n",
        "        \n",
        "        labels.append([Rs[i], Rct[i], Cdl[i], W[i], capacitance, energy_density, power_density])\n",
        "    \n",
        "    return np.array(spectra), np.array(labels)\n",
        "\n",
        "# Generate dataset\n",
        "frequencies = generate_frequency_grid(n_points=100, f_min=1e-3, f_max=1e6)\n",
        "print(f'Frequency grid: {frequencies[0]} Hz → {frequencies[-1]} Hz ({len(frequencies)} points, log-spaced)')\n",
        "\n",
        "print('Generating synthetic EIS dataset...')\n",
        "n_samples = 10000\n",
        "spectra, labels = generate_randles_circuit(n_samples, frequencies)\n",
        "\n",
        "print(f'  Generated {n_samples} spectra')\n",
        "print(f'Spectra shape: {spectra.shape}')\n",
        "print(f'Labels shape: {labels.shape}')\n",
        "\n",
        "target_names = ['Rs', 'Rct', 'Cdl', 'Warburg', 'Capacitance', 'Energy Density', 'Power Density']"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "preprocessing"
      },
      "source": [
        "# ============================================================\n",
        "# CELL 3 — PREPROCESSING & FEATURE ENGINEERING\n",
        "# ============================================================\n",
        "\n",
        "# Split data\n",
        "X_train, X_val, y_train, y_val = train_test_split(spectra, labels, test_size=0.15, random_state=SEED)\n",
        "\n",
        "# Scale features\n",
        "scaler = StandardScaler()\n",
        "X_train_scaled = scaler.fit_transform(X_train)\n",
        "X_val_scaled = scaler.transform(X_val)\n",
        "\n",
        "print(f'Training set: {X_train.shape[0]} samples')\n",
        "print(f'Validation set: {X_val.shape[0]} samples')\n",
        "print(f'Features: {X_train.shape[1]} (Z_real + Z_imag)')\n",
        "print(f'Targets: {y_train.shape[1]} parameters')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "random_forest"
      },
      "source": [
        "# ============================================================\n",
        "# CELL 4 — RANDOM FOREST MODEL (Trial 4)\n",
        "# ============================================================\n",
        "\n",
        "print('Training Random Forest model...')\n",
        "rf_model = RandomForestRegressor(\n",
        "    n_estimators=300,\n",
        "    max_depth=20,\n",
        "    min_samples_leaf=3,\n",
        "    random_state=SEED,\n",
        "    n_jobs=-1\n",
        ")\n",
        "rf_model.fit(X_train_scaled, y_train)\n",
        "\n",
        "# Evaluate\n",
        "rf_preds = rf_model.predict(X_val_scaled)\n",
        "rf_mae = mean_absolute_error(y_val, rf_preds, multioutput='raw_values')\n",
        "rf_rmse = np.sqrt(mean_squared_error(y_val, rf_preds, multioutput='raw_values'))\n",
        "rf_r2 = r2_score(y_val, rf_preds, multioutput='raw_values')\n",
        "\n",
        "print('Random Forest Performance:')\n",
        "for i, name in enumerate(target_names):\n",
        "    print(f'  {name:15s}: R\u00b2 = {rf_r2[i]:.4f}, RMSE = {rf_rmse[i]:.4f}')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "mlp_model"
      },
      "source": [
        "# ============================================================\n",
        "# CELL 5 — MLP NEURAL NETWORK (Trial 1-3)\n",
        "# ============================================================\n",
        "\n",
        "print('Training MLP model...')\n",
        "mlp_model = MLPRegressor(\n",
        "    hidden_layer_sizes=(256, 128, 64),\n",
        "    activation='relu',\n",
        "    learning_rate='adaptive',\n",
        "    learning_rate_init=0.001,\n",
        "    max_iter=500,\n",
        "    early_stopping=True,\n",
        "    validation_fraction=0.1,\n",
        "    random_state=SEED\n",
        ")\n",
        "mlp_model.fit(X_train_scaled, y_train)\n",
        "\n",
        "# Evaluate\n",
        "mlp_preds = mlp_model.predict(X_val_scaled)\n",
        "mlp_mae = mean_absolute_error(y_val, mlp_preds, multioutput='raw_values')\n",
        "mlp_rmse = np.sqrt(mean_squared_error(y_val, mlp_preds, multioutput='raw_values'))\n",
        "mlp_r2 = r2_score(y_val, mlp_preds, multioutput='raw_values')\n",
        "\n",
        "print('MLP Performance:')\n",
        "for i, name in enumerate(target_names):\n",
        "    print(f'  {name:15s}: R\u00b2 = {mlp_r2[i]:.4f}, RMSE = {mlp_rmse[i]:.4f}')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "1d_cnn"
      },
      "source": [
        "# ============================================================\n",
        "# CELL 6 — 1D CNN MODEL (Trial 5)\n",
        "# ============================================================\n",
        "\n",
        "class EIS1DCNN(nn.Module):\n",
        "    def __init__(self, input_dim, output_dim):\n",
        "        super(EIS1DCNN, self).__init__()\n",
        "        \n",
        "        self.conv1 = nn.Conv1d(1, 64, kernel_size=7, padding=3)\n",
        "        self.conv2 = nn.Conv1d(64, 128, kernel_size=5, padding=2)\n",
        "        self.conv3 = nn.Conv1d(128, 256, kernel_size=3, padding=1)\n",
        "        \n",
        "        self.pool = nn.MaxPool1d(2)\n",
        "        self.dropout = nn.Dropout(0.3)\n",
        "        \n",
        "        self.fc1 = nn.Linear(256 * 12, 512)\n",
        "        self.fc2 = nn.Linear(512, 128)\n",
        "        self.fc3 = nn.Linear(128, output_dim)\n",
        "        \n",
        "        self.relu = nn.ReLU()\n",
        "        self.bn1 = nn.BatchNorm1d(64)\n",
        "        self.bn2 = nn.BatchNorm1d(128)\n",
        "        self.bn3 = nn.BatchNorm1d(256)\n",
        "    \n",
        "    def forward(self, x):\n",
        "        x = x.unsqueeze(1)  # Add channel dimension\n",
        "        \n",
        "        x = self.relu(self.bn1(self.conv1(x)))\n",
        "        x = self.pool(x)\n",
        "        \n",
        "        x = self.relu(self.bn2(self.conv2(x)))\n",
        "        x = self.pool(x)\n",
        "        \n",
        "        x = self.relu(self.bn3(self.conv3(x)))\n",
        "        x = self.pool(x)\n",
        "        \n",
        "        x = x.view(x.size(0), -1)\n",
        "        \n",
        "        x = self.dropout(self.relu(self.fc1(x)))\n",
        "        x = self.dropout(self.relu(self.fc2(x)))\n",
        "        x = self.fc3(x)\n",
        "        \n",
        "        return x\n",
        "\n",
        "# Prepare data for PyTorch\n",
        "X_train_tensor = torch.FloatTensor(X_train_scaled).to(DEVICE)\n",
        "y_train_tensor = torch.FloatTensor(y_train).to(DEVICE)\n",
        "X_val_tensor = torch.FloatTensor(X_val_scaled).to(DEVICE)\n",
        "y_val_tensor = torch.FloatTensor(y_val).to(DEVICE)\n",
        "\n",
        "train_dataset = TensorDataset(X_train_tensor, y_train_tensor)\n",
        "train_loader = DataLoader(train_dataset, batch_size=64, shuffle=True)\n",
        "\n",
        "# Initialize model\n",
        "cnn_model = EIS1DCNN(input_dim=X_train_scaled.shape[1], output_dim=y_train.shape[1]).to(DEVICE)\n",
        "criterion = nn.MSELoss()\n",
        "optimizer = optim.Adam(cnn_model.parameters(), lr=0.001, weight_decay=1e-5)\n",
        "scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', factor=0.5, patience=10)\n",
        "\n",
        "# Training loop\n",
        "print('Training 1D-CNN model...')\n",
        "best_val_loss = float('inf')\n",
        "patience_counter = 0\n",
        "max_patience = 50\n",
        "\n",
        "for epoch in range(200):\n",
        "    cnn_model.train()\n",
        "    train_loss = 0\n",
        "    \n",
        "    for batch_X, batch_y in train_loader:\n",
        "        optimizer.zero_grad()\n",
        "        outputs = cnn_model(batch_X)\n",
        "        loss = criterion(outputs, batch_y)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "        train_loss += loss.item()\n",
        "    \n",
        "    # Validation\n",
        "    cnn_model.eval()\n",
        "    with torch.no_grad():\n",
        "        val_outputs = cnn_model(X_val_tensor)\n",
        "        val_loss = criterion(val_outputs, y_val_tensor).item()\n",
        "    \n",
        "    scheduler.step(val_loss)\n",
        "    \n",
        "    if val_loss < best_val_loss:\n",
        "        best_val_loss = val_loss\n",
        "        patience_counter = 0\n",
        "        torch.save(cnn_model.state_dict(), 'best_cnn_model.pth')\n",
        "    else:\n",
        "        patience_counter += 1\n",
        "    \n",
        "    if (epoch + 1) % 20 == 0:\n",
        "        print(f'Epoch {epoch+1}/200, Train Loss: {train_loss/len(train_loader):.6f}, Val Loss: {val_loss:.6f}')\n",
        "    \n",
        "    if patience_counter >= max_patience:\n",
        "        print(f'Early stopping at epoch {epoch+1}')\n",
        "        break\n",
        "\n",
        "# Load best model and evaluate\n",
        "cnn_model.load_state_dict(torch.load('best_cnn_model.pth'))\n",
        "cnn_model.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "    cnn_preds = cnn_model(X_val_tensor).cpu().numpy()\n",
        "\n",
        "cnn_mae = mean_absolute_error(y_val, cnn_preds, multioutput='raw_values')\n",
        "cnn_rmse = np.sqrt(mean_squared_error(y_val, cnn_preds, multioutput='raw_values'))\n",
        "cnn_r2 = r2_score(y_val, cnn_preds, multioutput='raw_values')\n",
        "\n",
        "print('\\n1D-CNN Performance:')\n",
        "for i, name in enumerate(target_names):\n",
        "    print(f'  {name:15s}: R\u00b2 = {cnn_r2[i]:.4f}, RMSE = {cnn_rmse[i]:.4f}')"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",

        "id": "model_comparison"
      },
      "source": [
        "# ============================================================\n",
        "# CELL 7 — MODEL COMPARISON & VISUALIZATION\n",
        "# ============================================================\n",
        "\n",
        "# Create comparison DataFrame\n",
        "comparison_data = []\n",
        "for i, name in enumerate(target_names):\n",
        "    comparison_data.append({\n",
        "        'Target': name,\n",
        "        'RF_R2': rf_r2[i],\n",
        "        'RF_RMSE': rf_rmse[i],\n",
